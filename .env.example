# Local Docker Postgres settings. These defaults are development-only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=travelplanner
POSTGRES_PORT=5433

DATABASE_URL="postgresql://postgres:localdevpassword@localhost:5433/travelplanner?schema=public"

# Free OpenRouteService API key (server-only) for routed walking and driving legs.
ORS_API_KEY=
